## Materials of the garderie, built once and cached by id (shared by every mesh using them).
## Shaders: res://shaders/garderie_{paint,vinyl,plastic,mats,net,balls}.gdshader. Textures: res://assets/garderie/textures
## (Poly Haven CC0 maps prefixed ph_, the rest generated by tools/gen_textures.py — see assets/garderie/CREDITS.md).
## Missing textures degrade gracefully (shader defaults), so the area still builds from a bare checkout.
extends RefCounted

const GL := preload("res://scripts/garderie/garderie_layout.gd")
const T := "res://assets/garderie/textures/"
const SH_PAINT := "res://shaders/garderie_paint.gdshader"
const SH_VINYL := "res://shaders/garderie_vinyl.gdshader"
const SH_PLASTIC := "res://shaders/garderie_plastic.gdshader"
const SH_MATS := "res://shaders/garderie_mats.gdshader"
const SH_NET := "res://shaders/garderie_net.gdshader"
const SH_BALLS := "res://shaders/garderie_balls.gdshader"

## Paint colours (sRGB) of the daycare: sky blue walls, sunflower band, tomato stripe, teal/tomato trims.
const SKY := Color(0.62, 0.77, 0.88)
const SUN := Color(0.93, 0.71, 0.2)
const TOMATO := Color(0.78, 0.2, 0.15)
const CREAM := Color(0.9, 0.87, 0.78)
const OLIVE := Color(0.34, 0.42, 0.3)

var _cache := {}
var _tex := {}
var _shaders := {}
var missing: Array[String] = []

func tex(name: String) -> Texture2D:
	if _tex.has(name):
		return _tex[name]
	var p := T + name
	var t: Texture2D = null
	if ResourceLoader.exists(p):
		t = load(p) as Texture2D
	if t == null:
		missing.append(name)
	_tex[name] = t
	return t

func _shader(path: String) -> Shader:
	if not _shaders.has(path):
		_shaders[path] = load(path) as Shader
	return _shaders[path]

func _sm(path: String, params: Dictionary) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = _shader(path)
	for k in params:
		var v: Variant = params[k]
		if v is String and (v as String).ends_with(".png") or v is String and (v as String).ends_with(".jpg"):
			v = tex(v)
			if v == null:
				continue
		m.set_shader_parameter(k, v)
	return m

func _paint(albedo: String, normal: String, orm: String, extra: Dictionary) -> ShaderMaterial:
	var p := {"noise_tex": "noise_rgba.png"}
	if albedo != "": p["albedo_tex"] = albedo
	if normal != "": p["normal_tex"] = normal
	else: p["use_normal"] = false
	if orm != "": p["orm_tex"] = orm
	p.merge(extra, true)
	return _sm(SH_PAINT, p)

## Returns the material `id` (see the match below). Unknown ids get a neutral grey material.
func mat(id: String) -> Material:
	if _cache.has(id):
		return _cache[id]
	var m: Material = _make(id)
	_cache[id] = m
	return m

func ids() -> Dictionary:
	return _cache

