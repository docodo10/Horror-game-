	g.albedo_color = Color(0.5, 0.5, 0.5)
	g.vertex_color_use_as_albedo = true
	return g

## Footpath wear segments (garderie_layout.gd WEAR_*) -> the mats shader's uniform array.
func _set_wear(m: ShaderMaterial, segs: Array) -> void:
	var arr := PackedVector4Array()
	for sg in segs:
		arr.append(Vector4(float(sg[0]), float(sg[1]), float(sg[2]), float(sg[3])))
	while arr.size() < 8:
		arr.append(Vector4.ZERO)
	m.set_shader_parameter("wear", arr)
	m.set_shader_parameter("wear_n", mini(segs.size(), 8))

func _emit(c: Color, energy: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.emission_enabled = true
	m.emission = c
	m.emission_energy_multiplier = energy
	m.roughness = 0.3
	return m

## Printed paper / painted board textures (signs, drawings, labels). cut = alpha scissor (PNG with alpha).
func _paper(name: String, cut: bool) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex(name)
	m.roughness = 0.82
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	if cut:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
		m.alpha_scissor_threshold = 0.5
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
	return m

func _emit_tex(name: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	var t := tex(name)
	m.albedo_texture = t
	m.albedo_color = Color(0.3, 0.3, 0.3)
	m.emission_enabled = true
	m.emission_texture = t
	m.emission = Color.WHITE
	m.emission_energy_multiplier = 4.0
	m.roughness = 0.25
	return m

## Duplicate of an emissive material whose energy can be animated alone (flicker, dying tube).
func emissive_instance(id: String) -> StandardMaterial3D:
	var src := mat(id) as StandardMaterial3D
	return src.duplicate() as StandardMaterial3D
