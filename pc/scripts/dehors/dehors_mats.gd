## Materials of chapter 3 (the yard): the garderie's material factory plus the outdoor ones ("dh_*"). Textures are
## looked for in res://assets/dehors/textures first (generated by scripts/dehors/tools/gen_dehors_textures.py), then
## in the garderie's folder, so every id of garderie_mats.gd still works here.
extends "res://scripts/garderie/garderie_mats.gd"

const TD := "res://assets/dehors/textures/"
const SH_GROUND := "res://shaders/dehors_ground.gdshader"

func tex(name: String) -> Texture2D:
	if _tex.has(name):
		return _tex[name]
	var p := TD + name
	if ResourceLoader.exists(p):
		var t := load(p) as Texture2D
		if t != null:
			_tex[name] = t
			return t
	return super.tex(name)

func _cut(name: String, tint: Color, scissor := 0.4) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex(name)
	m.albedo_color = tint
	m.vertex_color_use_as_albedo = true
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	m.alpha_scissor_threshold = scissor
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	m.roughness = 1.0
	m.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m

func _make(id: String) -> Material:
	match id:
		"dh_ground":
			return _sm(SH_GROUND, {"grass_tex": "grass.jpg", "grass_n": "grass_n.png", "gravel_tex": "gravel.jpg", "gravel_n": "gravel_n.png",
				"leaves_tex": "leaves.jpg", "leaves_n": "leaves_n.png", "noise_tex": "noise_rgba.png"})
		"dh_clapboard":
			return _paint("clapboard.jpg", "clapboard_n.png", "", {"uv_scale": 1.0 / 1.2, "floor_y": 0.0, "grime": 0.55, "grime_h": 1.4,
				"blotch": 0.22, "rough_mul": 0.8, "normal_strength": 1.0, "tint_low": Color(0.62, 0.64, 0.66), "tint_high": Color(0.62, 0.64, 0.66)})
		"dh_planks":
			return _paint("planks.jpg", "planks_n.png", "", {"uv_scale": 1.0 / 0.9, "floor_y": 0.0, "grime": 0.45, "grime_h": 0.5,
				"blotch": 0.25, "rough_mul": 0.85, "normal_strength": 1.0})
		"dh_deck":
			# the porch boards and the cellar doors: the same planks, wet
			return _paint("planks.jpg", "planks_n.png", "", {"uv_scale": 1.0 / 0.9, "floor_y": -10.0, "grime": 0.0, "blotch": 0.3,
				"rough_mul": 0.42, "normal_strength": 1.0, "tint_low": Color(0.8, 0.78, 0.74), "tint_high": Color(0.8, 0.78, 0.74)})
		"dh_stone":
			return _paint("stone.jpg", "stone_n.png", "", {"uv_scale": 1.0 / 1.5, "floor_y": -10.0, "grime": 0.0, "blotch": 0.25,
				"rough_mul": 0.8, "normal_strength": 1.1})
		"dh_flag":
			# the cellar floor: big damp flagstones
			return _paint("stone.jpg", "stone_n.png", "", {"uv_scale": 1.0 / 2.6, "floor_y": -10.0, "grime": 0.0, "blotch": 0.35,
				"rough_mul": 0.4, "normal_strength": 0.8, "tint_low": Color(0.5, 0.48, 0.45), "tint_high": Color(0.5, 0.48, 0.45)})
		"dh_bark":
			return _paint("bark.jpg", "bark_n.png", "", {"uv_scale": 1.0, "floor_y": 0.0, "grime": 0.3, "grime_h": 0.6, "blotch": 0.3,
				"rough_mul": 0.95, "normal_strength": 1.2, "grime_color": Color(0.2, 0.3, 0.14)})
		"dh_trees":
			return _cut("trees.png", Color(1.0, 1.0, 1.0), 0.35)
		"dh_tuft":
			return _cut("tuft.png", Color(0.6, 0.62, 0.55), 0.4)
		"dh_glass":
			# greenhouse panes: dirty, see-through, a mirror at grazing angles
			var gl := StandardMaterial3D.new()
			gl.albedo_texture = tex("glass.png")
			gl.albedo_color = Color(0.8, 0.9, 0.85, 1.0)
			gl.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			gl.cull_mode = BaseMaterial3D.CULL_DISABLED
			gl.roughness = 0.1
			gl.metallic_specular = 0.8
			gl.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
			return gl
		"dh_glass_dark":
			# the windows of the house and of the car: nothing behind them, the night on them
			var gd := StandardMaterial3D.new()
			gd.albedo_color = Color(0.012, 0.014, 0.018)
			gd.roughness = 0.07
			gd.metallic_specular = 0.9
			gd.clearcoat_enabled = true
			gd.clearcoat = 0.6
			gd.clearcoat_roughness = 0.05
			return gd
		"dh_car":
			return _paint("car_paint.jpg", "", "", {"uv_scale": 0.9, "floor_y": 0.0, "grime": 0.7, "grime_h": 0.55, "blotch": 0.25,
				"rough_mul": 0.36})
		"dh_sand":
			return _paint("sand.jpg", "", "", {"uv_scale": 1.3, "floor_y": -10.0, "grime": 0.0, "blotch": 0.3, "rough_mul": 0.95})
		"dh_rust":
			return _paint("", "", "", {"rough_mul": 0.7, "metal_mul": 0.35, "grime": 0.3, "floor_y": 0.0, "grime_h": 0.4, "blotch": 0.45,
				"tint_low": Color(0.3, 0.16, 0.09), "tint_high": Color(0.3, 0.16, 0.09)})
		"dh_iron":
			return _paint("", "", "", {"rough_mul": 0.5, "metal_mul": 0.8, "grime": 0.0, "blotch": 0.35,
				"tint_low": Color(0.07, 0.07, 0.075), "tint_high": Color(0.07, 0.07, 0.075)})
		"dh_window_lit":
			var wl := StandardMaterial3D.new()
			wl.albedo_color = Color(0.0, 0.0, 0.0)
			wl.emission_enabled = true
			wl.emission_texture = tex("window_glow.png")
			# (the emission texture is ADDED to the emission colour: black here)
			wl.emission = Color.BLACK if tex("window_glow.png") != null else Color(1.0, 0.6, 0.3)
			wl.emission_energy_multiplier = 1.5
			wl.roughness = 1.0
			return wl
		"dh_handprint":
			var hp := StandardMaterial3D.new()
			hp.albedo_texture = tex("handprint.png")
			hp.albedo_color = Color(0.9, 0.92, 0.88, 0.9)
			hp.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			hp.cull_mode = BaseMaterial3D.CULL_DISABLED
			hp.roughness = 0.9
			hp.emission_enabled = true                  # a little of its own light: it must read in the dark
			hp.emission = Color(0.05, 0.055, 0.05)
			hp.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
			return hp
		"dh_flame":
			return _emit(Color(1.0, 0.58, 0.22), 7.0)
		"dh_tube_cold":
			return _emit(Color(0.72, 1.0, 0.82), 2.4)
	return super._make(id)
